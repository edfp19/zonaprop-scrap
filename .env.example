POSTGRES_DB=zonaprop
POSTGRES_USER=zonaprop
POSTGRES_PASSWORD=zonaprop
# Cloud connections: DATABASE_URL overrides the separate POSTGRES_* settings.
# Enter the real URL only in .env or the provider's secret settings.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
COLLECTION_MAX_PAGES=1
COLLECTION_DELAY_SECONDS=3
COLLECTION_PAGE_TIMEOUT_SECONDS=45
PIPELINE_INTERVAL_SECONDS=86400
SPARK_MASTER=local[2]
COMPARABLE_MIN_COUNT=10
COMPARABLE_AREA_TOLERANCE=0.15
LOG_LEVEL=INFO
